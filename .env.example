# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
AUTH_DB_NAME=event_auth_db
USER_DB_NAME=event_user_db

# ==========================================
# SECURITY & JWT TOKENS (HMAC-SHA256)
# ==========================================
TOKEN_SECRET_KEY=your_256_bit_hex_secret_key_here
TOKEN_ACCESS_EXPIRATION_MS=900000
TOKEN_REFRESH_EXPIRATION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ==========================================
# TRANSACTIONAL EMAIL (BREVO REST API)
# ==========================================
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=your_verified_brevo_sender@gmail.com
MAIL_FROM_NAME=Event & Festival Platform

# ==========================================
# GOOGLE OAUTH2 FEDERATION
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# INTERNAL COMMUNICATION & GATEWAY
# ==========================================
INTERNAL_API_SECRET=your_internal_api_secret_token_here
FRONTEND_APP_URL=http://localhost:5173
EUREKA_HOST=localhost
