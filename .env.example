# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
AUTH_DB_NAME=event_auth_db
USER_DB_NAME=event_user_db
AD_DB_NAME=event_ad_db

# ==========================================
# REDIS CACHE (AD PUBLIC BANNERS)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
TICKET_DB_NAME=event_ticket_db
ORDER_DB_NAME=event_order_db
PAYMENT_DB_NAME=event_payment_db

# ==========================================
# SECURITY & JWT TOKENS (HMAC-SHA256)
# ==========================================
TOKEN_SECRET_KEY=your_256_bit_hex_secret_key_here
TOKEN_ACCESS_EXPIRATION_MS=900000
TOKEN_REFRESH_EXPIRATION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ==========================================
# TRANSACTIONAL EMAIL (BREVO REST API)
# ==========================================
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=your_verified_brevo_sender@gmail.com
MAIL_FROM_NAME="Event & Festival Platform"

# ==========================================
# GOOGLE OAUTH2 FEDERATION
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# INTERNAL COMMUNICATION & GATEWAY
# ==========================================
INTERNAL_API_SECRET=your_internal_api_secret_token_here
FRONTEND_APP_URL=http://localhost:5173
EUREKA_HOST=localhost

# ==========================================
# CLOUDINARY & EVENT SERVICE CONFIGURATION
# ==========================================
EVENT_DB_NAME=event_events_db
PROMOTION_DB_NAME=event_promotion_db
EVENT_SERVICE_PORT=8087
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ROOT_FOLDER=mss301-event-platform

# ==========================================
# PAYMENT GATEWAY: VNPAY (SANDBOX / PROD)
# ==========================================
VNPAY_TMN_CODE=DEMOVNPAY
VNPAY_HASH_SECRET=DEMOHASHSECRETKEY
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-callback
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ==========================================
# PAYMENT GATEWAY: SEPAY (VIETQR / BANK TRANSFER)
# ==========================================
SEPAY_API_KEY=sepay_secret_tkz_2026
SEPAY_BANK_ACCOUNT=0000000001
SEPAY_BANK_NAME=MBBank
SEPAY_QR_TEMPLATE=compact
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

